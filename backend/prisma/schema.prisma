// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  assignedTasks  Task[]           @relation("TaskAssignee")
  projects       Project[]
  projectMembers ProjectMember[]
  sprints        Sprint[]
  activities     Activity[]
  reminders      Reminder[]
  aiCommands     AICommand[]
  sentInvites    ProjectInvite[]  @relation("InviteSender")
  receivedInvites ProjectInvite[] @relation("InviteReceiver")

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks   Task[]
  sprints Sprint[]
  members ProjectMember[]
  invites ProjectInvite[]
  activities Activity[]

  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid())
  role      ProjectRole       @default(MEMBER)
  joinedAt  DateTime          @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_members")
}

model ProjectInvite {
  id        String        @id @default(uuid())
  email     String
  role      ProjectRole   @default(MEMBER)
  status    InviteStatus  @default(PENDING)
  token     String        @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime      @default(now())

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User    @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  inviteeId   String?
  invitee     User?   @relation("InviteReceiver", fields: [inviteeId], references: [id], onDelete: SetNull)

  @@map("project_invites")
}

model Task {
  id             String     @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  dueDate        DateTime?
  position       Int        @default(0)
  labels         String[]
  estimatedHours Float?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sprintId   String?
  sprint     Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     Task?    @relation("SubTasks", fields: [parentId], references: [id])
  subtasks   Task[]   @relation("SubTasks")

  activities Activity[]

  @@map("tasks")
}

model Sprint {
  id        String       @id @default(uuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@map("sprints")
}

model Reminder {
  id          String   @id @default(uuid())
  title       String
  description String?
  remindAt    DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@map("activities")
}

model AICommand {
  id          String   @id @default(uuid())
  input       String
  output      Json
  actionType  String
  isProcessed Boolean  @default(true)
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_commands")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_MOVED
  SPRINT_CREATED
  SPRINT_UPDATED
  AI_COMMAND
  REMINDER_SET
  PROJECT_CREATED
  USER_REGISTERED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
}
